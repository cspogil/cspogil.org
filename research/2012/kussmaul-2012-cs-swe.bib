  author    = {Clifton L. Kussmaul},
  booktitle = {2012 ASEE Annual Conference \&amp; Exposition},
  title     = {Process Oriented Guided Inquiry Learning (POGIL) in Computer Science and Software Engineering},
  year      = {2012},
